SEC_COMPANY_NAME=your_project_or_organization
SEC_EMAIL=your_email@example.com

# --- LLM providers (src/llm, profiles in config/llm_profiles.toml) ---
# Cloud APIs: the SDK knows the URL; set only the keys you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Self-hosted servers (vLLM on Colab/Kaggle): one pair per profile whose
# provider is openai_compat or http_rerank, named <KIND>_<NAME>_BASE_URL /
# <KIND>_<NAME>_API_KEY after its [<kind>.<name>] section. vLLM serves one
# model per server, so chat, embedding and rerank each have their own URL.
# A tunnel URL changes every notebook session; always start vLLM with
# `--api-key` because the tunnel is public.
CHAT_LOCAL_BASE_URL=          # e.g. https://xxxx.trycloudflare.com/v1
CHAT_LOCAL_API_KEY=
EMBEDDING_DEFAULT_BASE_URL=
EMBEDDING_DEFAULT_API_KEY=
RERANK_DEFAULT_BASE_URL=
RERANK_DEFAULT_API_KEY=

# Optional: use another profiles file (e.g. on the server).
# LLM_PROFILES_PATH=config/llm_profiles.toml
