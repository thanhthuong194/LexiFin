SEC_COMPANY_NAME=your_project_or_organization
SEC_EMAIL=your_email@example.com

# --- LLM providers (src/llm, profiles in config/llm_profiles.toml) ---
# Cloud APIs: the SDK knows the URL; set only the keys you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible servers (Groq, NVIDIA, vLLM on Colab/Kaggle): one pair
# per profile whose provider is openai_compat or http_rerank, named
# <KIND>_<NAME>_BASE_URL / <KIND>_<NAME>_API_KEY after its [<kind>.<name>]
# section, e.g. [chat.judge] -> CHAT_JUDGE_*. A vLLM tunnel URL changes every
# notebook session; always start vLLM with `--api-key` (the tunnel is public).
CHAT_GENERATOR_BASE_URL=      # e.g. https://api.groq.com/openai/v1
CHAT_GENERATOR_API_KEY=
CHAT_QUERY_BASE_URL=          # e.g. https://api.groq.com/openai/v1
CHAT_QUERY_API_KEY=
CHAT_JUDGE_BASE_URL=          # e.g. https://integrate.api.nvidia.com/v1
CHAT_JUDGE_API_KEY=
EMBEDDING_DEFAULT_BASE_URL=
EMBEDDING_DEFAULT_API_KEY=
RERANK_DEFAULT_BASE_URL=
RERANK_DEFAULT_API_KEY=

# Optional: use another profiles file (e.g. on the server).
# LLM_PROFILES_PATH=config/llm_profiles.toml
